<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pagina Principala | NovaSphere Solutions</title>
    <link href="images/favicon.png" rel="icon" type="image/x-icon" />

    <link rel="stylesheet" type="text/css" href="~/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/css/supstyle.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>
<body>

    <header class="header fixed-header">
        <div class="container header-container">
            <a href="#home" class="logo">NovaSphere <span class="highlight">Solutions</span></a>
            <nav class="navbar">
                <ul>
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">Despre Noi</a></li>
                    <li><a href="#vacancies">Locuri de Muncă</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button id="loginBtn" class="btn btn-secondary"><i class="fas fa-user-circle"></i> Log In</button>
            </div>
        </div>
    </header>


    <section class="home hero-section" id="home">
        <div class="text-box container">
            <h1 class="heading">Găsește-ți Pasiunea: <span class="highlight typing-text">Aplică la jobul visat!</span></h1>
            <p class="tagline">
                Ești în căutarea unui loc de muncă? Explorează oportunitățile noastre și trimite CV-ul tău astăzi!
            </p>

            <form class="job-search-form">
                <input type="text" id="job-search-input" placeholder="Caută după titlu, domeniu sau locație..." aria-label="Job Search Input">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Caută</button>
            </form>

            <div class="quick-links">
                <a href="#avantages"><i class="fas fa-star"></i> Avantajele Noastre</a>
                <a href="#vacancies"><i class="fas fa-arrow-down"></i> Vezi Toate Joburile</a>
            </div>
        </div>
    </section>

    <div id="myModal" class="modal">
        <div class="modal-content login-modal">
            <form method="post" class="Login" id="loginform">
                <button class="close-modal-btn" id="close" type="button">&times;</button>
                <div class="imgcontainer">
                    <i class="fas fa-user-lock avatar-icon"></i>
                </div>
                <div class="container form-body">
                    <h2>Admin Login</h2>
                    <label for="uname"><b>Username</b></label>
                    <input type="text" placeholder="Enter Username" name="uname" id="uname" required />

                    <label for="psw"><b>Password</b></label>
                    <input type="password" placeholder="Enter Password" name="psw" id="pname" required />

                    <button class="btn btn-primary UserLogin" type="submit" id="UserLogin">Login</button>
                </div>
            </form>
        </div>
    </div>


    <section class="about section-padding" id="about">
        <div class="container about-container">
            <div class="about-text">
                <h1 class="heading">Despre <span class="highlight">Noi</span></h1>
                <p>
                    Noi suntem o echipa ce angajeaza studenti si oameni dornici de a lucra. Daca esti o persoana energica inteligenta si ai dori sa incerci ceva nou, gaseste job-ul visurilor tale aici.
                </p>
                <a href="#" class="btn btn-secondary">Afla mai multe</a>
            </div>
            <img class="about-image" src="~/css/images/teamwork-placeholder.png" alt="Team members smiling">
        </div>
    </section>


    <section class="avantages section-padding" id="avantages">
        <div class="container">
            <h1 class="heading">De ce <span class="highlight">NovaSphere?</span></h1>
            <p class="subheading">Învățați aptitudinile de care aveți nevoie pentru a reuși</p>

            <div class="advantages-grid">
                <div class="advantage-card">
                    <i class="fas fa-bell icon-large"></i>
                    <h3>Notificari instantanee</h3>
                    <p>Veți primi notificări push atunci când este vizualizat CV-ul sau când apar noi locuri de muncă în cea mai recentă căutare.</p>
                </div>
                <div class="advantage-card">
                    <i class="fas fa-bolt icon-large"></i>
                    <h3>Aplicare rapidă</h3>
                    <p>Aplicați cu ușurință la mai multe locuri de muncă cu un singur clic! Aplicație rapidă vă arată locurile de muncă recomandate.</p>
                </div>
                <div class="advantage-card">
                    <i class="fas fa-chart-line icon-large"></i>
                    <h3>Instrumente salariale</h3>
                    <p>Vezi cum se compară salariul tău cu al altor persoane cu același titlu de post din zona ta, și ce abilități îți lipsesc.</p>
                </div>
            </div>
        </div>
    </section>


    <section class="vacancies section-padding" id="vacancies">
        <div class="container">
            <h2 class="heading">Locuri de Muncă <span>Disponibile</span></h2>

            <div class="vacancies-layout-grid">

                <div class="job-listings">
                    <p class="job-count-indicator">Afișăm <span id="job-count">0</span> de poziții vacante.</p>
                    <div class="vacancies-grid" id="vacanciescont">
                        <div class="no-vacancies-message" style="display: none;">Nu există poziții disponibile în acest moment.</div>
                    </div>
                </div>

                <div class="cv-placer-column sticky-form-wrapper">
                    <div class="cv-placer-container" id="cv-placer-box">
                        <form class="CV-PlacerBody" method="post" id="cvuniqid">
                            <div class="formContent">
                                <h2><i class="fas fa-upload"></i> Trimite CV-ul</h2>
                                <p class="form-instructions">Completează detaliile și încarcă CV-ul tău pentru a aplica rapid.</p>

                                <input class="formInput" name="formInputName" type="text" placeholder="Nume" required />
                                <input class="formInput" name="formInputSurname" type="text" placeholder="Prenume" required />
                                <input class="formInput" name="formInputEmail" type="email" placeholder="Email" required />
                                <input class="formInput" id="formInputPhone" name="formInputPhone" type="tel" placeholder="Telefon" />

                                <label class="formLabel upload-label" for="UploadCV"><i class="fas fa-file-upload"></i> Încarcă CV-ul (PDF/DOCX)</label>
                                <input type="file" id="UploadCV" style="display: none;" required />

                                <button class="btn btn-primary formSubmit" type="submit">Aplicați</button>
                                <span class="applyDone success-message" style="display: none;">V-ați aplicat cu succes!</span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </section>


    <footer class="footercont" id="contact">
        <div class="container footer-grid">
            <div class="footer-col">
                <h2>OUR COMPANY</h2>
                <p><a href="#about">Despre Noi</a></p>
                <p><i class="fas fa-phone"></i> Contact: +37368483577</p>
                <p><i class="fas fa-envelope"></i> aftercyberattack@gmail.com</p>
                <p><i class="fas fa-map-marker-alt"></i> Sediul Central: Chișinău, Moldova</p>
            </div>
            <div class="footer-col">
                <h2>EXPLOREAZĂ</h2>
                <p><a href="#vacancies">Locuri de Muncă</a></p>
                <p><a href="#avantages">Avantaje</a></p>
                <p><a href="#news">Noutăți</a></p>
            </div>
            <div class="footer-col contact-form-col">
                <h2>CONTACT RAPID</h2>
                <form action="#">
                    <input type="text" placeholder="Numele tău" required />
                    <input type="email" placeholder="Email" required />
                    <button class="btn btn-primary" type="submit">TRIMITE</button>
                </form>
            </div>
        </div>
    </footer>
    <script type="text/javascript" src="js/update.js"></script>
</body>
</html>